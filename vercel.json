{
  "version": 2,
  "builds": [
    {
      "src": "modern-angular/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "installCommand": "cd modern-angular && npm ci",
  "buildCommand": "cd modern-angular && npm run build",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}